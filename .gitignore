# Build artifacts
service/bin/
web/dist/
web/node_modules/
# tsc byproducts of the vite.config.ts project reference (tsconfig.node.json is
# `composite: true`, which forces emit — cannot be disabled without breaking the
# project reference). Vite consumes vite.config.ts directly; these are unused.
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Go
*.test
*.out
vendor/

# IDE
.vscode/
.idea/
.DS_Store

# Local config / secrets (never commit)
.env
.env.local
*.pem
*.key
*.crt

# Logs
*.log

# OS
Thumbs.db

# Editor/backup files (e.g. *.bak-YYYYMMDD left by tooling)
*.bak
*.bak-*
